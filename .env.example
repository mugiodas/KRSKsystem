# KRSK SYSTEM — 本番起動時の設定
# `npm start` はリポジトリルートの .env を自動的に読みます（コピーして編集してください）。
# 開発（`npm run dev`）ではこれらの値がなくても動きます。

# HTTP リッスンポート（開発時は Vite が /api をここにプロキシする）
PORT=3001

# SQLite ファイルの位置。無ければフォルダを作って初期化します。
# 大会データはこの1ファイルがすべて → バックアップもこの1ファイルです。
DATABASE_PATH=./data/krsk.sqlite

# production にすると API が dist/（前端）も一緒に配信します（1プロセスで完結）
NODE_ENV=production

# セッション Cookie の Secure フラグ。既定は production で on（https が前提）。
# 体育館の LAN で http://192.168.x.x:3001 を使う場合は 0 にしてください。
# on のままだとブラウザが Cookie を返さず、ログインできるのに次の画面で弾かれます。
COOKIE_SECURE=1

# デモ大会とデモ用アカウント（owner@krsk.local / krsk-demo など）を入れるかどうか。
# 既定: production では off、開発では on。
# 空の production DB では OWNER_EMAIL / OWNER_PASSWORD からオーナー1人だけ作ります。
DEMO_MODE=0

# 本番初回のオーナー。OWNER_PASSWORD を省略するとランダム生成して起動ログに1回だけ出します。
OWNER_EMAIL=owner@example.jp
# OWNER_PASSWORD=
# OWNER_NAME=唐崎ジュニア 運営
